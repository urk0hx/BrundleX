# BrundleX Environment Configuration

# MalwareBazaar API Configuration
# Get your API key from https://bazaar.abuse.ch/
MALWAREBAZAAR_API_KEY=your_malwarebazaar_api_key_here
MALWAREBAZAAR_API_URL=https://mb-api.abuse.ch/api/v1/

# Database Storage
TRAITS_DB_PATH=data/traits.db

# Harvester Gatekeeper Configuration
MAX_ENTROPY_THRESHOLD=7.1

# OpenAI-Compatible Local / Remote LLM Endpoint
# Common endpoint URLs:
#   Ollama:           http://localhost:11434/v1 (or http://host.containers.internal:11434/v1 from container)
#   LM Studio:        http://localhost:1234/v1
#   vLLM / OpenWebUI: http://localhost:8000/v1
#   OpenAI:           https://api.openai.com/v1
LLM_API_BASE=http://host.containers.internal:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3:8b
LLM_FALLBACK_MODEL=llama3.2:3b
LLM_TIMEOUT_SECONDS=30

# Container & Runtime Settings
CONTAINER_IMAGE_NAME=brundlex-agent
